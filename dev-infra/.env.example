# Variables del stack dev-infra. Copia este archivo a .env (no se versiona):
#   cp .env.example .env
# Docker Compose lo carga automáticamente.
# Evita comillas simples (') y dobles (") en las contraseñas: se interpolan en scripts SQL.

# ── MinIO ────────────────────────────────────────────────
# Credenciales root (administrador) de MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password-dev

# Bucket que se crea al arrancar, y el usuario/contraseña con acceso a ese bucket
MINIO_BUCKET_NAME=developer
MINIO_BUCKET_USER=developer
MINIO_BUCKET_PASSWORD=password-dev

# ── Bases de datos ───────────────────────────────────────
# Usuario y contraseña que se crean en PostgreSQL, MySQL, Redis, Oracle, MongoDB y SQL Server
DEV_USER=developer
DEV_PASSWORD=password-dev

# Contraseña de root en PostgreSQL, MySQL y MongoDB, y de SYSTEM en Oracle
DB_ROOT_PASSWORD=password-dev

# Contraseña de 'sa' en SQL Server: mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos
MSSQL_SA_PASSWORD=Dev-Passw0rd!2026
