# =============================================================
# dev-tools — .gitignore
# =============================================================

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
Icon?

# --- Windows ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Linux ---
*~
.directory
.Trash-*

# --- Editores / IDEs ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.swp
*.swo
nbproject/private/
.claude/settings.local.json

# --- Secretos y overrides locales ---
# Los archivos con credenciales NO se versionan. Se versionan solo las plantillas:
#   dev-infra/.env.example -> copiar a dev-infra/.env
.env
.env.*
!.env.example
*.local.env
*.local
docker-compose.override.yml
compose.override.yaml

# --- Logs y temporales ---
*.log
*.tmp
*.bak
tmp/

# --- Datos locales de contenedores (si alguien usa bind mounts) ---
dev-infra/data/
dev-infra/volumes/

